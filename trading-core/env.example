# TEMPLATE ONLY. Never commit actual secrets. No broker/Topstep fields exist.
# Node backend / Railway (existing DATABASE_URL remains the same):
TRADING_ENABLED=false
# DATABASE_URL is already managed by the existing backend; do not replace blindly.
# DATABASE_URL=postgresql://...
TRADING_API_SECRET=
# Create separate random tokens, not the dashboard password:
TRADING_INGEST_TOKEN=
TRADING_INTELLIGENCE_TOKEN=

# Existing Vercel login: DASHBOARD_PASSWORD stays unchanged.
# Vercel only: private own-backend URL + SAME admin secret as above.
TRADING_BACKEND_URL=
TRADING_PUBLIC_ORIGIN=https://marcelmarlow.com
# RAILWAY_BACKEND_URL and DASHBOARD_API_SECRET remain supported as fallbacks.

# Licensed independent market data (server/worker only):
TRADING_DATABENTO_ENABLED=false
TRADING_DATABENTO_KEY=
TRADING_HISTORY_MAX_COST_USD=0.50
# Comma-separated EXACT raw contracts from your vendor subscription.
# Examples ONLY; not a current front-month recommendation:
TRADING_FEED_SYMBOLS=
TRADING_INGEST_URL=
# Example: https://YOUR-OWN-BACKEND/trading-api?resource=ingest
# Use a persistent private volume OUTSIDE the static website:
TRADING_FEED_OUTBOX=/private-data/trading/market-outbox.sqlite

# Separate context data: titles/links, daily FRED values, licensed calendar.
TRADING_NEWS_ENABLED=false
TRADING_FRED_KEY=
TRADING_ECONOMIC_CALENDAR_KEY=
TRADING_CONTEXT_INTERVAL_MS=900000
# Enable below only for standalone server polling, NOT in addition to context.js:
TRADING_CONTEXT_POLL=false

# Optional standalone local server (not needed for the existing Railway runtime):
TRADING_HOST=127.0.0.1
TRADING_PORT=3090
TRADING_LOCAL_PASSWORD=
# Local private persistence file, NOT within the repo/public website:
TRADING_LOCAL_FILE=
TRADING_SECURE_COOKIE=false
TRADING_DEBUG=false
